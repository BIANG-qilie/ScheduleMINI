{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小日程",
  "version": "../package.json",
  "identifier": "com.desktop.schedule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:45231",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "小日程",
        "url": "index.html",
        "width": 1080,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "小日程",
        "url": "index.html?view=widget",
        "width": 320,
        "height": 440,
        "minWidth": 260,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true,
    "android": {
      "versionCode": 2010
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5QzRDNUNEQkYwMjFGREYKUldUZkh3Sy96Y1hFU1FCTnFySnUzTkNlMElTTjh2WUY3WG5sUDlkUVZmOFFSRXltazNYd015UU8K",
      "endpoints": [
        "https://static-host-e3n8jbll-schedulemini.sealosgzg.site/schedulemini/latest.json",
        "https://github.com/BIANG-qilie/ScheduleMINI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
