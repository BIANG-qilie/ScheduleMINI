{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面日程小窗",
  "version": "0.1.0",
  "identifier": "com.desktop.schedule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:45231",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "桌面日程小窗",
        "url": "index.html",
        "width": 880,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "今日日程",
        "url": "index.html?view=widget",
        "width": 320,
        "height": 440,
        "minWidth": 260,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
